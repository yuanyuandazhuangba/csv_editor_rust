// 代码页声明（必须有，否则版本信息里的中文会乱码）：
// windres 默认按本地代码页解析 .rc（中文系统为 936/GBK），而本文件是 UTF-8，
// 这会让 ProductName 等中文值在 exe 属性里显示成乱码（实测："瀹跨粡03瓒呭ぇ…"）。
// 显式声明 65001 后中文正确；MSVC 的 rc.exe 同样支持该 pragma，跨编译器通用。
#pragma code_page(65001)

// 图标资源
IDI_ICON1 ICON "assets/csv_editor_icon.ico"

// 版本信息
1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          0x40004
FILETYPE        0x1
{
  BLOCK "StringFileInfo"
  {
    BLOCK "080404b0"
    {
      VALUE "CompanyName", "SZJZ-王安工作室"
      VALUE "FileDescription", "宿经03超大CSV文件实用编辑器 (Rust)"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "csv_editor_rust"
      VALUE "OriginalFilename", "CSV_Editor_Rust.exe"
      VALUE "ProductName", "宿经03超大CSV文件实用编辑器"
      VALUE "ProductVersion", "1.0.0"
    }
  }
  BLOCK "VarFileInfo"
  {
    VALUE "Translation", 0x0804, 1200
  }
}
